# Simulator image: backfill (one-shot) and live streamer share it, the
# compose command picks the mode. Modeled on Dockerfile.ingester — the
# simulator reuses the ingester's parser/flavor code at runtime (tsx).

FROM node:22-bookworm-slim

RUN apt-get update -y && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY prisma ./prisma
RUN npx prisma generate

COPY mqtt-ingester ./mqtt-ingester
COPY simulator ./simulator
COPY src/types ./src/types
COPY tsconfig.json ./
COPY vitest.config.ts ./

CMD ["npx", "tsx", "simulator/index.ts", "live"]
