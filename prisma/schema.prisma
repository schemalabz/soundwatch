generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Sensor {
  id                String    @id @default(uuid())
  deviceId          String    @unique @map("device_id")
  name              String?
  latitude          Float?
  longitude         Float?
  address           String?
  firmwareVersion   String?   @map("firmware_version")
  targetFirmwareVersion String? @map("target_firmware_version")
  readingIntervalS  Int       @default(60) @map("reading_interval_s")
  isActive          Boolean   @default(true) @map("is_active")
  lastSeenAt        DateTime? @map("last_seen_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  readings Reading[]

  @@map("sensors")
}

model Reading {
  id          BigInt   @id @default(autoincrement())
  sensorId    String   @map("sensor_id")
  // recordedAt: device clock — when the sound actually happened (may be old on a
  // store-and-forward replay). receivedAt: server insert time — lets us tell a
  // buffered-backlog replay apart from live data.
  recordedAt  DateTime @map("recorded_at")
  receivedAt  DateTime @default(now()) @map("received_at")
  noiseDba    Float?   @map("noise_dba")
  temperature Float?
  humidity    Float?
  lightLux    Float?   @map("light_lux")
  pressurePa  Float?   @map("pressure_pa")
  uvA         Float?   @map("uv_a")
  uvB         Float?   @map("uv_b")
  uvC         Float?   @map("uv_c")
  pm1         Float?
  pm25        Float?
  pm4         Float?
  pm10        Float?
  pn05        Float?   @map("pn_05")
  pn10        Float?   @map("pn_10")
  pn25        Float?   @map("pn_25")
  pn40        Float?   @map("pn_40")
  pn100       Float?   @map("pn_100")
  tps         Float?
  battery     Float?
  rssi        Float?
  sdCard      Float?   @map("sd_card")

  // Flavor 1 (Step 4): raw device accumulators + server-computed levels.
  payloadVersion Int?    @map("payload_version")
  energySum      Float?  @map("energy_sum")
  frameCount     Int?    @map("frame_count")
  intervalS      Int?    @map("interval_s")
  maxEnergy      Float?  @map("max_energy")
  minEnergy      Float?  @map("min_energy")
  laeq           Float?
  realizedDuty   Float?  @map("realized_duty")
  lmaxEst        Float?  @map("lmax_est")
  lminEst        Float?  @map("lmin_est")

  // Flavor 2: packed spectrum (raw) + computed percentiles/band dB.
  histRaw        String? @map("hist_raw")
  bandsRaw       String? @map("bands_raw")
  l10            Float?
  l50            Float?
  l90            Float?
  bandsDb        Json?   @map("bands_db")

  sensor Sensor @relation(fields: [sensorId], references: [id])

  @@index([sensorId, recordedAt(sort: Desc)], map: "idx_readings_sensor_time")
  @@map("readings")
}
