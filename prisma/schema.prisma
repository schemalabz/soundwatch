generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Sensor {
  id                String    @id @default(uuid())
  deviceId          String    @unique @map("device_id")
  name              String?
  latitude          Float?
  longitude         Float?
  address           String?
  firmwareVersion   String?   @map("firmware_version")
  targetFirmwareVersion String? @map("target_firmware_version")
  readingIntervalS  Int       @default(60) @map("reading_interval_s")
  isActive          Boolean   @default(true) @map("is_active")
  lastSeenAt        DateTime? @map("last_seen_at")
  // Unique SAMD21 chip id, self-reported on device/inventory. Survives reflash,
  // token change and relocation — the only identifier that answers "which
  // physical box is this?". Used to catch units swapped during installation.
  hardwareId        String?   @map("hardware_id")
  // Setup-AP name (Smartcitizen<last4 of softAP MAC>) — recorded at provisioning
  // because it cannot be derived from anything else, and the installer needs it
  // to join the right box when several are on a table.
  apName            String?   @map("ap_name")
  provisionedAt     DateTime? @map("provisioned_at")
  installedAt       DateTime? @map("installed_at")
  // Which planned site this unit was confirmed at. Null + coordinates set
  // means an unplanned install (recorded, flagged in admin). Copy-on-bind:
  // name/address are copied at install time, not read through this relation.
  plannedLocationId String?          @map("planned_location_id")
  plannedLocation   PlannedLocation? @relation(fields: [plannedLocationId], references: [id])
  // Bench/experimental units: keep them out of public maps and aggregates.
  isExperimental    Boolean   @default(false) @map("is_experimental")
  createdAt         DateTime  @default(now()) @map("created_at")

  readings Reading[]

  @@map("sensors")
}

// Planned deployment sites, imported from the operator's spreadsheet.
// `key` is the stable import identity: re-imports upsert by key and never
// duplicate. Sites are retired with isActive=false, never deleted, so
// historical bindings keep their FK.
model PlannedLocation {
  id        String   @id @default(uuid())
  key       String   @unique
  name      String
  latitude  Float
  longitude Float
  address   String?
  notes     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  sensors   Sensor[]

  @@map("planned_locations")
}

model Reading {
  id          BigInt   @id @default(autoincrement())
  sensorId    String   @map("sensor_id")
  // recordedAt: device clock — when the sound actually happened (may be old on a
  // store-and-forward replay). receivedAt: server insert time — lets us tell a
  // buffered-backlog replay apart from live data.
  recordedAt  DateTime @map("recorded_at")
  receivedAt  DateTime @default(now()) @map("received_at")
  noiseDba    Float?   @map("noise_dba")
  temperature Float?
  humidity    Float?
  lightLux    Float?   @map("light_lux")
  pressurePa  Float?   @map("pressure_pa")
  uvA         Float?   @map("uv_a")
  uvB         Float?   @map("uv_b")
  uvC         Float?   @map("uv_c")
  pm1         Float?
  pm25        Float?
  pm4         Float?
  pm10        Float?
  pn05        Float?   @map("pn_05")
  pn10        Float?   @map("pn_10")
  pn25        Float?   @map("pn_25")
  pn40        Float?   @map("pn_40")
  pn100       Float?   @map("pn_100")
  tps         Float?
  battery     Float?
  rssi        Float?
  sdCard      Float?   @map("sd_card")

  // Flavor 1 (Step 4): raw device accumulators + server-computed levels.
  payloadVersion Int?    @map("payload_version")
  energySum      Float?  @map("energy_sum")
  frameCount     Int?    @map("frame_count")
  intervalS      Int?    @map("interval_s")
  intervalMs     Int?    @map("interval_ms")
  maxEnergy      Float?  @map("max_energy")
  minEnergy      Float?  @map("min_energy")
  laeq           Float?
  realizedDuty   Float?  @map("realized_duty")
  lmaxEst        Float?  @map("lmax_est")
  lminEst        Float?  @map("lmin_est")

  // Flavor 2: packed spectrum (raw) + computed percentiles/band dB.
  histRaw        String? @map("hist_raw")
  bandsRaw       String? @map("bands_raw")
  l10            Float?
  l50            Float?
  l90            Float?
  bandsDb        Json?   @map("bands_db")
  // Device health telemetry, unpacked from id 243. The only window into a
  // deployed unit — no site access, no SAM-side OTA.
  deviceUptimeS  Int?    @map("device_uptime_s")
  freeHeapBytes  Int?    @map("free_heap_bytes")
  // SAMD21 RCAUSE. 32 = watchdog. 64 = "SYST", which covers BOTH a software
  // reset and a power cycle (the UF2 bootloader resets before the app runs),
  // so 64 cannot distinguish "lost power" from "reset itself".
  resetCause     Int?    @map("reset_cause")
  wifiConnects   Int?    @map("wifi_connects")
  publishFails   Int?    @map("publish_fails")
  captureFails   Int?    @map("capture_fails")
  i2sReinits     Int?    @map("i2s_reinits")
  ghostRefusals  Int?    @map("ghost_refusals")

  sensor Sensor @relation(fields: [sensorId], references: [id])

  @@unique([sensorId, recordedAt], map: "readings_sensor_id_recorded_at_key")
  @@index([sensorId, recordedAt(sort: Desc)], map: "idx_readings_sensor_time")
  @@map("readings")
}

// SD-path v1: raw FRAMELOG.CSV chunks uplinked from devices, keyed by byte
// offset — resumable, idempotent; reassembly = string_agg(data order by offset).
model FrameLogChunk {
  id         BigInt   @id @default(autoincrement())
  deviceId   String   @map("device_id")
  offset     Int
  data       String
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamp(3)

  @@unique([deviceId, offset])
  @@map("frame_log_chunks")
}
