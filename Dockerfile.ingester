FROM node:22-bookworm-slim

RUN apt-get update -y && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY prisma ./prisma
RUN npx prisma generate

COPY mqtt-ingester ./mqtt-ingester
COPY scripts ./scripts
COPY src/types ./src/types
COPY tsconfig.json ./
COPY vitest.config.ts ./

# The frame-log pacer and probe run as one-shot containers from this same image,
# so they ship inside it rather than being bind-mounted from the droplet.
# Mounting meant a deploy updated the ingester's parser but NOT the pacer,
# letting the two halves of one wire contract drift apart silently — the exact
# class of failure that produced serve-mute.
COPY scripts ./scripts

# Apply pending migrations before starting. Without this a deploy brings up code
# that writes columns the database does not have yet — every insert fails and the
# ingester silently stores nothing. The ingester is the only writer, so it is the
# natural place to own schema convergence; prisma takes an advisory lock, so a
# restart loop cannot corrupt state.
# timescale-objects owns the continuous aggregate + policies: cagg DDL cannot
# run inside Prisma's migration transaction, so it runs as a separate
# idempotent step right after the migrations land.
CMD ["sh", "-c", "npx prisma migrate deploy && npx tsx scripts/timescale-objects.ts && exec npx tsx mqtt-ingester/index.ts"]
