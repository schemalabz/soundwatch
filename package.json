{
  "name": "soundwatch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "ingester": "tsx --env-file-if-exists=.env mqtt-ingester/index.ts",
    "seed": "tsx --env-file-if-exists=.env scripts/seed-sensors.ts",
    "sim:backfill": "tsx --env-file-if-exists=.env simulator/index.ts backfill",
    "sim:live": "tsx --env-file-if-exists=.env simulator/index.ts live",
    "local:up": "docker compose -f docker-compose.local.yml up --build -d && docker compose -f docker-compose.local.yml logs -f sim-backfill",
    "local:logs": "docker compose -f docker-compose.local.yml logs -f",
    "local:down": "docker compose -f docker-compose.local.yml down",
    "local:nuke": "docker compose -f docker-compose.local.yml down -v"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "mapbox-gl": "^3.23.1",
    "mqtt": "^5.15.1",
    "next": "16.2.6",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/mapbox-gl": "^3.4.1",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
